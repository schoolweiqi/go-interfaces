{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schoolweiqi-go-network",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://schoolweiqi.github.io,http://localhost:8000,http://127.0.0.1:8000"
  }
}
